/* =============================================================================
   CONTENT PALETTE — not chrome.
   Syntax highlighting carries meaning: these hues encode Lua token classes and
   are deliberately NOT folded into the zinc roles above. Base is the Material
   Palenight set the Script Editor already shipped. They live here so the
   invariant "no colour outside theme.rcss" stays absolute and testable.

     code-text        #d8d8dc   base code / identifier
     code-keyword     #c792ea   code-string    #c3e88d
     code-comment     #697098   code-number    #f78c6c
     code-operator    #89ddff
     code-error-bg    #3a1f24   code-error-rule #f07178
     code-bracket     #3b82f6   on #ffffff     (matched pair)
     code-caret-layer #00000000 (functional transparency, see below)
   ============================================================================= */
.script-editor-highlight { color: #d8d8dc; }
.script-editor-highlight .lua-kw  { color: #c792ea; }   /* keyword    */
.script-editor-highlight .lua-str { color: #c3e88d; }   /* string     */
.script-editor-highlight .lua-com { color: #697098; }   /* comment    */
.script-editor-highlight .lua-num { color: #f78c6c; }   /* number     */
.script-editor-highlight .lua-op  { color: #89ddff; }   /* operator   */
.script-editor-highlight .lua-id  { color: #d8d8dc; }   /* identifier */
.script-editor-highlight .lua-line-error {
    background-color: #3a1f24;
    border-bottom: 1px #f07178;
}
/* Matched-bracket highlight: brand tint is legitimate here — it marks a
   caret-driven pair in code, not a call to action. */
.script-editor-highlight .lua-bracket {
    color: #ffffff;
    background-color: #3b82f6;
}
/* The editable textarea sits invisibly over the highlighted layer: its own
   glyphs must not paint, so the transparency is functional, not decorative. */
textarea#script-editor-textarea.script-editor-textarea { color: #00000000; }
