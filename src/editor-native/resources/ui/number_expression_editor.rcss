/* ADR-0028 — Number Expression Editor structure only (colours in theme.rcss). */

.number-expression-modal {
    width: 720dp;
    height: 560dp;
    max-width: 92%;
    max-height: 86%;
    padding: 0dp;
    display: flex;
    flex-direction: column;
}

.number-expression-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12dp 14dp;
    border-bottom-width: 1px;
    flex-shrink: 0;
}

.number-expression-header-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.number-expression-title {
    display: block;
    font-size: 15dp;
    font-weight: 600;
    margin-bottom: 2dp;
}

.number-expression-subtitle {
    display: block;
    font-size: 12dp;
}

.number-expression-result {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    padding: 10dp 14dp;
    margin: 10dp 14dp 0dp 14dp;
    border-width: 1px;
    border-radius: 3dp;
}

.number-expression-result-label {
    font-size: 11dp;
    margin-bottom: 4dp;
}

.number-expression-result-text {
    font-size: 13dp;
    white-space: nowrap;
    overflow: hidden;
}

.number-expression-error {
    flex-shrink: 0;
    margin: 8dp 14dp 0dp 14dp;
    padding: 8dp 10dp;
    border-width: 1px;
    border-radius: 3dp;
}

.number-expression-tree {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 10dp 14dp 8dp 14dp;
}

.number-expression-node {
    display: flex;
    flex-direction: column;
    margin-bottom: 8dp;
    padding: 8dp 10dp;
    border-width: 1px;
    border-radius: 3dp;
}

.number-expression-node-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6dp;
}

.number-expression-node-kind {
    margin-right: 8dp;
    font-size: 12dp;
    font-weight: 600;
    flex-shrink: 0;
}

.number-expression-node-summary {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 12dp;
    margin-right: 8dp;
}

.number-expression-change {
    flex-shrink: 0;
    height: 24dp;
    padding: 0 8dp;
}

.number-expression-literal-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6dp;
}

.number-expression-literal-label {
    width: 48dp;
    margin-right: 6dp;
    font-size: 12dp;
    flex-shrink: 0;
}

.number-expression-literal-input {
    flex: 1;
    min-width: 0;
    height: 28dp;
}

.number-expression-picker {
    margin: 4dp 0 8dp 0;
    padding: 8dp;
    border-width: 1px;
    border-radius: 3dp;
}

.number-expression-picker-label {
    display: block;
    margin-bottom: 6dp;
    font-size: 12dp;
    font-weight: 600;
}

.number-expression-picker-category {
    margin: 8dp 0 2dp 0;
}

.number-expression-picker-category-label {
    font-size: 10dp;
}

.number-expression-picker-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.number-expression-pick-btn {
    margin: 0 6dp 6dp 0;
}

.number-expression-variable-row {
    display: flex;
    flex-direction: column;
    margin-bottom: 6dp;
}

.number-expression-variable-scope {
    margin-bottom: 4dp;
    font-size: 11dp;
}

.number-expression-variable-choices {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.number-expression-variable-choices .panel-btn {
    margin: 0 6dp 6dp 0;
}

.number-expression-variable-empty {
    font-size: 11dp;
}

.number-expression-child {
    display: flex;
    flex-direction: column;
    margin-top: 8dp;
    margin-left: 10dp;
}

.number-expression-child-label {
    margin-bottom: 4dp;
    font-size: 11dp;
}

.number-expression-footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding: 10dp 14dp 14dp 14dp;
    border-top-width: 1px;
}

.number-expression-footer .panel-btn {
    margin-left: 8dp;
}

.logic-vec2-group {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.logic-parameter-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 4dp;
}

.logic-parameter-label {
    width: 18dp;
    margin-right: 6dp;
    font-size: 12dp;
}

.logic-expression-button {
    width: 28dp;
    height: 26dp;
    margin-left: 6dp;
    text-align: center;
    border-width: 1px;
    border-radius: 3dp;
}

.logic-expression-summary {
    display: flex;
    flex: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    height: 28dp;
    padding: 0 8dp;
    border-width: 1px;
    border-radius: 3dp;
}

.logic-expression-badge {
    margin-right: 6dp;
    font-size: 11dp;
}

.logic-expression-summary-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 12dp;
}

.logic-expression-edit {
    margin-left: 6dp;
    height: 26dp;
    padding: 0 8dp;
    border-width: 1px;
    border-radius: 3dp;
}
