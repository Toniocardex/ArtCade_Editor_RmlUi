/* sprite_animation_editor.rcss — Sprite Animation Editor overlay.
   Same design language as the main shell (zinc surfaces, blue accent, flat
   fills, low radius). IMPORTANT: RmlUi has no browser default stylesheet —
   every element is display:inline unless declared otherwise, so each container
   here sets its display explicitly. Raw text must not sit directly inside a
   display:flex element (it won't render); text always lives in a span/div. */

.animation-editor-body {
    width: 100%;
    height: 100%;
    display: block;

}

.animation-editor {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;

}

/* Shell: header / main row / timeline as one vertical flex so the sheet canvas
   takes all remaining space at any window size. */
.anim-editor-shell {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;   /* 100% + padding must not overflow the window */
    width: 100%;
    height: 100%;
    padding: 12dp;

}

/* -- Header bar ------------------------------------------------------------ */
.anim-editor-title {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 36dp;
    margin-bottom: 10dp;

}
.anim-editor-eyebrow {
    display: inline-block;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1.1dp;
    text-transform: uppercase;
}
.anim-editor-name {
    display: inline-block;
    margin-left: 10dp;

    font-size: 13dp;
    font-weight: 600;
}
.anim-editor-title .panel-btn { margin: 0 0 6dp auto; }

/* -- Main row: clips | sheet | settings ------------------------------------- */
.anim-editor-main {
    display: flex;
    flex-direction: row;
    flex: 1;
    margin-bottom: 10dp;
}

/* Shared panel surface + eyebrow section title. */
.anim-clips,
.anim-sheet,
.anim-settings {


    border-radius: 4dp;
}
.anim-panel-title {
    display: block;
    height: 18dp;
    line-height: 18dp;
    margin-bottom: 8dp;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1.1dp;
    text-transform: uppercase;
}

/* Empty-state overrides: the shared 11dp/#52525b reads as noise on these dark
   panels; inside this editor the guidance must stay legible. */
.animation-editor .assets-empty {
    font-size: 12dp;

}

/* -- Clips column ------------------------------------------------------------ */
.anim-clips {
    display: flex;
    flex-direction: column;
    width: 220dp;
    margin-right: 10dp;
    padding: 10dp;
}
/* Animation switcher: all animation assets in the project. Capped height with
   its own scroll so the Clips list below always stays visible. */
.anim-asset-list {
    display: block;
    max-height: 150dp;
    overflow-y: auto;
    margin-bottom: 8dp;
}
.anim-asset {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 28dp;
    padding: 0 8dp;
    margin-bottom: 4dp;
    border-radius: 2dp;
    border-left: 2dp transparent;

    transition: background-color 0.1s, color 0.1s;
}


.anim-asset-name { flex: 1; font-size: 12dp; }

/* Same grey-to-red "remove" language as the Inspector's .comp-remove: quiet
   until hovered, never competing with the row's own open-sprite-animation. */
.anim-asset-remove {
    display: inline-block;
    width: 18dp;
    height: 18dp;
    line-height: 18dp;
    margin-left: 6dp;
    text-align: center;
    border-radius: 2dp;

    transition: background-color 0.1s, color 0.1s;
}


/* Gap before the Clips sub-section title. */
.anim-section-gap { margin-top: 6dp; }

.anim-clip-list {
    display: block;
    flex: 1;
    overflow-y: auto;
    margin-bottom: 8dp;
}
.anim-clip {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 28dp;
    padding: 0 8dp;
    margin-bottom: 4dp;
    border-radius: 2dp;
    border-left: 2dp transparent;

    transition: background-color 0.1s, color 0.1s;
}


.anim-clip-name { flex: 1; font-size: 12dp; }
.anim-clip-count {
    display: inline-block;

    font-size: 11dp;
}


/* Full-width dashed-style add action at the bottom of the list. */
.anim-add-clip {
    display: block;
    height: 26dp;
    line-height: 26dp;
    text-align: center;

    border-radius: 2dp;

    font-size: 11dp;
    font-weight: 500;
    transition: border-color 0.1s, color 0.1s;
}


/* Secondary: import a new sheet and start a fresh animation (asset-level). */
.anim-import-sheet {
    display: block;
    height: 26dp;
    line-height: 26dp;
    margin-top: 6dp;
    text-align: center;
    border: 1px transparent;
    border-radius: 2dp;

    font-size: 11dp;
    font-weight: 500;
    transition: background-color 0.1s, color 0.1s;
}


/* -- Sheet column ------------------------------------------------------------ */
.anim-sheet {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-right: 10dp;
    padding: 10dp;
}
.anim-sheet-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 22dp;
    margin-bottom: 8dp;
}
.anim-sheet-head .anim-panel-title { margin-bottom: 0; }
.anim-sheet-meta {
    display: inline-block;
    margin-left: 8dp;

    font-size: 12dp;
}
.sheet-view-reset { margin: 0 0 0 auto; }

/* Slicing toolbar: labelled groups on one wrapping row. */
.anim-slice-controls {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 6dp 8dp;
    margin-bottom: 8dp;


    border-radius: 4dp;
}
.anim-tool-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 26dp;
    margin-right: 16dp;
}
.anim-tool-label {
    display: inline-block;
    margin-right: 8dp;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 0.6dp;
    text-transform: uppercase;
}
.anim-tool-field {
    display: inline-block;
    margin-left: 6dp;

    font-size: 12dp;
}
/* .prop-input is flex:1 (basis 0) for Inspector rows; inside this auto-sized
   flex container that collapses the fields to their padding. Pin them. */
.anim-slice-controls .prop-input {
    flex: 0 0 auto;
    width: 44dp;
    height: 24dp;
    line-height: 24dp;
    margin-left: 4dp;
}
.anim-slice-controls .slice-action { margin: 0 0 0 10dp; }
.anim-slice-controls .panel-btn { margin-bottom: 0; }



.anim-sprite-canvas {
    display: block;
    flex: 1;
    min-height: 120dp;


    border-radius: 4dp;
}
.anim-sheet-footer {
    display: block;
    margin-top: 8dp;

    font-size: 11dp;
}

/* Empty state banner: guidance + primary CTA above the sheet. */
.anim-canvas-empty {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10dp 12dp;
    margin-bottom: 8dp;


    border-radius: 4dp;
}
.anim-canvas-empty-text { display: block; flex: 1; }
.anim-canvas-empty-title {
    display: block;
    margin-bottom: 4dp;

    font-size: 13dp;
    font-weight: 600;
}
.anim-canvas-empty-hint {
    display: block;

    font-size: 11dp;
}
.anim-canvas-empty-cta {
    display: inline-block;
    height: 28dp;
    line-height: 28dp;
    margin-left: 12dp;
    padding: 0 12dp;


    border-radius: 2dp;

    font-size: 12dp;
    font-weight: 600;
    transition: background-color 0.1s;
}


/* -- Settings column ---------------------------------------------------------- */
.anim-settings {
    display: flex;
    flex-direction: column;
    width: 300dp;
    padding: 10dp 12dp;
}
.anim-settings .prop-label { width: 64dp; }
.anim-preview-title { margin-top: 12dp; }

.anim-preview-canvas {
    display: block;
    height: 170dp;
    margin-bottom: 8dp;


    border-radius: 4dp;
}

/* Transport: centred icon buttons under the preview canvas. */
.anim-transport {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 6dp;
}
.anim-transport .panel-btn {
    width: 36dp;
    padding: 0;
    margin: 0 4dp;
}
.anim-transport .icon { margin-right: 0; }

/* The toggle carries both icon glyphs; "active" (= preview playing) picks
   which one shows. Keeps play state out of the generated panel markup. */
.anim-preview-toggle .preview-when-playing { display: none; }
.anim-preview-toggle.active .preview-when-playing { display: inline; }
.anim-preview-toggle.active .preview-when-stopped { display: none; }

/* Pushes Remove Clip to the panel bottom, away from everyday controls. */
.anim-settings-spacer { display: block; flex: 1; }
.anim-remove-clip {
    display: block;
    height: 26dp;
    line-height: 26dp;
    text-align: center;

    border-radius: 2dp;

    font-size: 11dp;
    font-weight: 500;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}


/* -- Timeline strip ------------------------------------------------------------ */
.anim-timeline {
    display: flex;
    flex-direction: column;
    height: 150dp;
    padding: 10dp 12dp;


    border-radius: 4dp;
}
.anim-timeline-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 20dp;
    margin-bottom: 8dp;
}
.anim-timeline-head .anim-panel-title { margin-bottom: 0; }
.anim-timeline-readout {
    display: inline-block;
    margin-left: 8dp;

    font-size: 11dp;
}
.anim-timeline-head .panel-btn { margin: 0 0 0 auto; }

.anim-timeline-track {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    flex: 1;
    overflow-x: auto;
}
.anim-frame {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;   /* keep width; overflow the track horizontally, do not shrink */
    width: 68dp;
    height: 84dp;
    margin-right: 6dp;


    border-radius: 2dp;
    transition: border-color 0.1s;
}



/* Head strip: order badge (left) + remove (right). Stays above the thumb so the
   raylib overlay, which paints only the thumb rect, never covers the controls. */
.anim-frame-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 18dp;
    padding: 0 4dp;
}
.anim-frame-order {
    flex: 1;

    font-size: 11dp;
    font-weight: 600;
}

.anim-frame-remove {
    display: inline-block;
    width: 15dp;
    height: 15dp;
    line-height: 15dp;
    text-align: center;
    border-radius: 2dp;

    font-size: 12dp;
    transition: background-color 0.1s, color 0.1s;
}


/* Reserved rect for the raylib-drawn frame image. */
.anim-frame-thumb {
    display: block;
    flex: 1;
    margin: 0 4dp 4dp 4dp;

    border-radius: 2dp;
}


scrollbarhorizontal { height: 8dp; }

scrollbarhorizontal sliderbar {

    border-radius: 2dp;
    margin-top: 2dp;
    margin-bottom: 2dp;
    min-width: 32dp;
}
