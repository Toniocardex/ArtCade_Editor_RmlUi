/* controls.rcss — menu, toolbar, tabs, tree rows, inputs, buttons.
   Flat fills (no gradients), low radius, single-accent selection. State classes
   (.disabled/.active/.selected) come from C++ and must win, so they come last.
   NOTE: raw text must not sit inside a display:flex element in RmlUi (it won't
   render) — text-bearing controls are block/inline-block, centred via line-height.
   Lengths in `dp` (DPI-scaled); 1px borders/separators stay physical hairlines. */

/* -- Menu bar -------------------------------------------------------------- */
.brand {
    display: inline-block;
    line-height: 30dp;
    padding: 0 12dp 0 6dp;

    font-size: 12dp;
    font-weight: 700;
    letter-spacing: 0.4dp;
}
.menu-item {
    display: inline-block;
    position: relative;
    height: 22dp;
    line-height: 22dp;
    padding: 0 10dp;
    margin: 0 2dp;
    border-radius: 2dp;

    font-size: 12dp;
    font-weight: 400;
    transition: background-color 0.1s, color 0.1s;
}

/* -- File menu dropdown (open state is local visual state, hover-driven) ----
   `top` overlaps the trigger by 1dp (menu-item is 22dp tall) rather than
   sitting flush below it: any real gap is a dead zone the pointer can slip
   through while moving from the label to the dropdown, dropping :hover and
   snapping the menu shut before the cursor arrives. */
.menu-dropdown {
    display: none;
    position: absolute;
    top: 21dp;
    left: 0;
    z-index: 100;
    min-width: 168dp;
    padding: 4dp;

    border-width: 1px;
    border-radius: 4dp;
}
.menu-item:hover .menu-dropdown { display: block; }
.menu-dropdown-right {
    left: auto;
    right: 0;
}
/* Base entries stay block: RmlUi flex containers do not lay out bare text
   children, and most menu rows are `<span class="icon"/>Label` with the label
   as a raw text node (File/Edit/View, the Create dropdown, context menus).
   Rows that need the right-aligned shortcut column opt into flex via
   .with-shortcut and must wrap their text in menu-entry-label/-shortcut. */
.menu-entry {
    display: block;
    height: 28dp;
    line-height: 28dp;
    padding: 0 10dp;
    border-radius: 2dp;

    font-size: 13dp;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.1s, color 0.1s;
}
.menu-entry.disabled:hover { background-color: transparent;  }
.menu-entry.with-shortcut {
    display: flex;
    flex-direction: row;
    align-items: center;
}
.menu-entry-label {
    flex: 1;
}
.menu-entry-shortcut {
    margin-left: auto;
    padding-left: 16dp;

    font-size: 11dp;
    font-weight: 400;
}
.menu-separator {
    height: 1px;
    margin: 4dp 6dp;
}
/* Section label inside a dropdown (e.g. the Create menu's "Object types"
   catalog): explains what the rows below are, same eyebrow style as panel
   titles but menu-sized. */
.menu-section {
    display: block;
    height: 20dp;
    line-height: 20dp;
    padding: 0 10dp;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1.1dp;
    text-transform: uppercase;
}
/* Muted trailing hint on a menu entry (the object type's stable id next to
   its display name — default-named types would otherwise be identical rows). */
.menu-entry-hint {
    margin-left: 8dp;

    font-size: 11dp;
    font-weight: 400;
}

/* -- Toolbar buttons — flat ------------------------------------------------ */
.tool-btn {
    display: inline-block;
    flex: 0 0 auto;
    height: 28dp;
    line-height: 28dp;
    text-align: center;
    margin: 4dp;
    padding: 0 12dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 13dp;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}

.tool-btn.primary {

    font-weight: 600;
}

/* Primary call-to-action: Play Project (accent). */
#btn-play-project {

    border-width: 1px;

    font-weight: 600;
}

/* Stop — restrained danger (only enabled while playing). */

.tool-sep {
    display: block;
    flex: 0 0 auto;
    width: 1px;
    height: 18dp;
    margin: 0 8dp;
}
.tool-sep.hidden { display: none; }

/* Tilemap paint tools: Scene toolbar only (workspace tools, not Inspector). */
.tilemap-context-tools.hidden { display: none; }
.toolbar-tilemap-stamp {
    display: inline-block;
    flex: 0 0 auto;
    margin: 4dp 6dp;
    padding: 0 4dp;

    font-size: 12dp;
    line-height: 28dp;
    white-space: nowrap;
}
.toolbar-tilemap-stamp.hidden { display: none; }
.toolbar-tilemap-stamp .value {  font-weight: 600; }

/* Icon-only toolbar buttons (zoom +/-): tighter padding, no icon gap. */
.tool-icon { padding: 0 10dp; }
.tool-icon .icon { margin-right: 0; }

/* Pointer world position readout (Edit mode, mouse over the scene). Monospace
   so the X/Y digits don't shift width as the pointer moves. */
.status-coords {
    display: inline-block;
    flex: 1;
    box-sizing: border-box;
    min-width: 0;
    line-height: 24dp;
    margin-left: 12dp;
    padding: 0;
    overflow: hidden;
    text-align: center;

    font-family: JetBrains Mono;
    font-size: 11dp;
    font-weight: 500;
    letter-spacing: 0.4dp;
    white-space: nowrap;
}

/* 120dp used to clip even the plain default case ("Scene 1  |  Layer 1  |
   EDIT" already overflows it before a user ever renames anything); 260dp
   covers every default-name combination, including "LOGIC - <type>", with
   overflow:hidden kept only as a backstop for pathologically long
   user-renamed scenes/layers/types (same graceful-clip convention as
   .asset-name/.row-name elsewhere, not a layout guarantee). */
.status-health {
    display: inline-block;
    height: 22dp;
    line-height: 22dp;
    padding: 0 4dp;
    background-color: transparent;
    border: 0;

    font-size: 10dp;
}
.status-dot {
    display: inline-block;
    width: 6dp;
    height: 6dp;
    margin-right: 6dp;
    border-radius: 2dp;
}
.status-context {
    display: inline-block;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 420dp;
    line-height: 24dp;
    margin-left: 12dp;
    overflow: hidden;
    text-align: right;
    white-space: nowrap;
}
.status-project {
    display: inline-block;
    flex: 0 0 auto;
    max-width: 260dp;
    line-height: 24dp;
    margin-left: 12dp;
    overflow: hidden;
    text-align: right;
    white-space: nowrap;
}

/* Clickable zoom readout: shows the active scene zoom %, click resets to 100%. */
.toolbar-zoom {
    display: inline-block;
    flex: 0 0 auto;
    height: 24dp;
    line-height: 24dp;
    margin: 4dp 2dp;
    padding: 0 8dp;
    border-radius: 2dp;

    font-size: 12dp;
    font-weight: 500;
    transition: background-color 0.1s, color 0.1s;
}
.toolbar-zoom.disabled:hover { background-color: transparent; }

.grid-size-control {
    display: inline-block;
    flex: 0 0 auto;
    position: relative;
}
.grid-size-trigger {
    min-width: 58dp;
    padding: 0 12dp;
}
/* top overlaps the 28dp trigger by 1dp — see .menu-dropdown for why.
   Width fits four presets (8/16/32/64) on one row; the old 154dp box
   wrapped "64" outside the popover. */
.grid-size-popover {
    display: none;
    position: absolute;
    top: 27dp;
    left: 0;
    z-index: 120;
    width: 176dp;
    padding: 8dp;

    border-width: 1px;
    border-radius: 4dp;
    box-sizing: border-box;
}
.grid-size-control:hover .grid-size-popover { display: block; }
.grid-size-title {
    display: block;
    height: 16dp;
    line-height: 16dp;
    margin: 0 0 6dp 0;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 0.5dp;
}
.grid-size-input {
    display: block;
    width: 160dp;
    height: 26dp;
    line-height: 26dp;
    margin: 0 0 8dp 0;
    padding: 0 8dp;

    border-width: 1px;
    border-radius: 2dp;

    font-family: "JetBrains Mono";
    font-size: 12dp;
    box-sizing: border-box;
}
.grid-size-presets {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 160dp;
    height: 26dp;
}
.grid-size-preset {
    flex: 1;
    height: 26dp;
    line-height: 26dp;
    min-width: 0;
    margin: 0 2dp;
    padding: 0;
    background-color: transparent;
    border-width: 1px;
    border-radius: 2dp;

    font-size: 11dp;
    text-align: center;
}
.grid-size-control.disabled .grid-size-popover { display: none; }

/* Tilemap cell size: read-only navigation affordance (not an editor). */
#btn-grid-size.grid-size-nav {

    cursor: pointer;
}
.grid-nav-icon {
    display: inline-block;
    margin-left: 4dp;
    font-size: 10dp;
    line-height: 28dp;
    vertical-align: top;
}

/* Disabled toolbar buttons (state class wins). */
.tool-btn.disabled,
#btn-play-project.disabled,
#btn-play-scene.disabled,
#btn-stop.disabled,
#btn-grid-visible.disabled,
#btn-grid-snap.disabled,
#btn-grid-size.disabled {

    border-width: 1px;
}

/* -- Hierarchy action row — flat outline buttons --------------------------- */
.panel-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8dp 8dp 4dp 10dp;
}

/* "+ Create" hover dropdown (same local-visual-state pattern as the File menu). */
.create-menu {
    display: inline-block;
    position: relative;
}
/* top overlaps the 24dp trigger by 1dp — see .menu-dropdown for why. */
.create-dropdown {
    display: none;
    position: absolute;
    top: 23dp;
    left: 0;
    z-index: 120;
    min-width: 168dp;
    padding: 4dp;

    border-width: 1px;
    border-radius: 4dp;
}
.create-menu:hover .create-dropdown { display: block; }

/* Per-row menu affordance on scene tabs and tree rows. Glyph is a Tabler icon
   (caret-down), not raw Unicode — Inter's Latin-only subset has no arrow glyphs. */
.tab-menu,
.row-menu {
    display: inline-block;
    width: 16dp;
    text-align: center;
    margin-left: 4dp;
    border-radius: 2dp;

    font-family: tabler-icons;
    font-weight: 400;
    transition: background-color 0.1s, color 0.1s;
}/* Destructive context-menu entries hint red on hover only. */

/* Tree section eyebrow ("Instances"). */
.tree-section {
    display: block;
    padding: 6dp 10dp 2dp 10dp;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1dp;
    text-transform: uppercase;
}
.panel-btn {
    display: inline-block;
    height: 24dp;
    line-height: 24dp;
    text-align: center;
    margin: 0 4dp 4dp 0;
    padding: 0 10dp;
    background-color: transparent;
    border-width: 1px;
    border-radius: 2dp;

    font-size: 11dp;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}

.panel-btn.disabled {
    background-color: transparent;
    border-width: 1px;
}

/* -- Inspector "Add Component" menu (in-flow toggle, not a popup) ----------- */
.add-component { display: block; margin: 16dp 0 4dp 0; }
.add-component-btn {
    display: block;
    height: 30dp;
    line-height: 30dp;
    text-align: center;
    border-width: 1px;
    border-radius: 2dp;

    font-size: 12dp;
    font-weight: 500;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}
.add-component-btn.disabled {   background-color: transparent; }
.add-list {
    display: block;
    margin-top: 4dp;
    padding: 4dp;

    border-width: 1px;
    border-radius: 4dp;
}
.add-entry {
    display: block;
    height: 26dp;
    line-height: 26dp;
    padding: 0 10dp;
    border-radius: 2dp;

    font-size: 12dp;
    transition: background-color 0.1s, color 0.1s;
}

/* -- Inspector value dropdown (Layer / Source / Tileset) --------------------
   One prop-row trigger showing the current value; the option list expands
   in-flow below it (same click-toggle pattern as Add Component — a floating
   popup would be clipped by the Inspector's scroll region). Trigger text is
   centred via line-height with the caret pinned right, per the flex/raw-text
   note at the top of this file. */
.drop-trigger {
    flex: 1;
    display: block;
    position: relative;
    height: 26dp;
    line-height: 26dp;
    padding: 0 24dp 0 8dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 12dp;
    white-space: nowrap;
    overflow: hidden;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}
/* ADR-0034 spike: only the Scene Layer picker joins the tab order today, via
   this class on its trigger — Tab reaching it and Enter/Space opening it
   (RmlUi treats tab-index: auto as "click on Enter/Space") is then native
   behaviour, not new C++. Other dropdown triggers are unaffected. */
.drop-trigger.kbd-nav { tab-index: auto; }
.drop-caret {
    position: absolute;
    top: 0;
    right: 6dp;
    font-family: tabler-icons;
    font-weight: 400;
}
.drop-list {
    display: block;
    /* ds-exception(spacing): aligns options with the inspector value column; ref=scene */
    margin: 2dp 0 8dp 78dp;
    padding: 4dp;

    border-width: 1px;
    border-radius: 4dp;
}
.drop-entry {
    display: block;
    height: 24dp;
    line-height: 24dp;
    padding: 0 8dp;
    border-radius: 2dp;

    font-size: 11dp;
    white-space: nowrap;
    overflow: hidden;
    transition: background-color 0.1s, color 0.1s;
}
.drop-entry.disabled:hover { background-color: transparent;  }
/* Group eyebrows (Images / Animations) sit tighter inside the list. */
.drop-list .asset-group-title { margin: 6dp 0 4dp 4dp; }

/* -- Inspector asset picker ------------------------------------------------ */

/* -- Viewport context menu ------------------------------------------------- */
.context-menu {
    display: block;
    position: absolute;
    z-index: 200;
    min-width: 188dp;
    padding: 4dp;

    border-width: 1px;
    border-radius: 4dp;
}
.context-entry {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 28dp;
    line-height: 28dp;
    padding: 0 10dp;
    border-radius: 2dp;

    font-size: 12dp;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.1s, color 0.1s;
}
.context-entry .icon {
    flex: 0 0 auto;
    width: 16dp;
    margin-right: 6dp;
}
.context-shortcut {
    margin-left: auto;
    padding-left: 12dp;

    font-size: 10dp;
}
.context-submenu-caret {
    margin-left: auto;
    padding-left: 12dp;

    font-family: tabler-icons;
    font-size: 11dp;
}
.context-entry.has-submenu {
    position: relative;
}
.context-submenu {
    display: none;
    position: absolute;
    left: 100%;
    top: -4dp;
    z-index: 210;
    min-width: 160dp;
    /* Positive gap so the flyout reads as its own detached panel — a
       negative margin here previously pulled it back into the parent's
       padding, fusing the two borders into one continuous shape. */
    margin-left: 6dp;
    padding: 4dp;

    border-width: 1px;
    border-radius: 4dp;
}
.context-entry.has-submenu:hover > .context-submenu {
    display: block;
}
.context-submenu .context-entry.disabled:hover {
    background-color: transparent;
}
.hidden { display: none; }

/* -- Scene Inspector: layer rows ------------------------------------------- */
.layer-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 26dp;
    padding: 0 4dp;
    margin-bottom: 2dp;
    border-radius: 2dp;

    transition: background-color 0.1s, color 0.1s;
}
.layer-eye {
    display: inline-block;
    width: 22dp;
    text-align: center;
}
.layer-lock {
    display: inline-block;
    width: 22dp;
    text-align: center;

    transition: color 0.1s;
}
.layer-name { flex: 1; font-size: 12dp; padding: 0 4dp; }
.layer-rename-input {
    flex: 1;
    height: 22dp;
    line-height: 22dp;
    padding: 0 6dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 12dp;
}
/* Indent lines up with the layer name text: 4dp row padding + 22dp eye
   + 22dp lock + 4dp name padding. */
.layer-rename-error {
    display: block;
    /* ds-exception(spacing): aligns validation with the layer-name column; ref=scene */
    margin: 0 0 4dp 52dp;

    font-size: 10dp;
}
.layer-btn {
    display: inline-block;
    width: 20dp;
    text-align: center;

    font-size: 13dp;
    border-radius: 2dp;
    transition: background-color 0.1s, color 0.1s;
}
/* Inert reorder arrow (top row's ↑, bottom row's ↓): keeps the arrow columns
   aligned across rows without pretending to be clickable. */
.layer-btn.disabled:hover { background-color: transparent;  }
.layer-remove {
    display: inline-block;
    width: 20dp;
    text-align: center;

    font-size: 13dp;
    border-radius: 2dp;
    transition: background-color 0.1s, color 0.1s;
}
/* "Add Layer" sits in-flow right under the last layer row — separate it so
   the action reads apart from the list (panel-btn has no top margin). */
.layer-add-btn { margin-top: 6dp; }

/* -- Scene tabs — flat ----------------------------------------------------- */
/* A distinct background (not the bare panel colour) reads as its own toolbar
   strip rather than blending into the rest of the Hierarchy (UX feedback: the
   scene switcher was easy to miss). */
.scene-tabs {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 6dp 8dp 8dp 10dp;

    border-bottom-width: 1px;
}
/* No scenes: the empty strip is just a dark band — collapse it. Needs its own
   rule: .scene-tabs above outranks the generic .hidden by order. */
.scene-tabs.hidden { display: none; }
.tab {
    display: inline-block;
    height: 28dp;
    line-height: 28dp;
    text-align: center;
    padding: 0 12dp;
    margin: 0 4dp 4dp 0;
    border-radius: 2dp;
    border-width: 1px;

    font-size: 12dp;
    font-weight: 500;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}

/* -- Hierarchy tree — flat rows, accent-tint selection + left bar ---------- */
.tree {
    display: block;
    flex: 1;
    padding: 4dp 0;
    overflow-y: auto;
}
.tree-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    box-sizing: border-box;
    height: 26dp;
    padding: 0 4dp 0 8dp;
    border-left: 2dp transparent;
    background-color: transparent;

    transition: background-color 0.1s, color 0.1s;
}
.row-icon {
    flex: 0 0 auto;
    width: 16dp;
    margin-right: 4dp;
}
.row-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;

    font-size: 11dp;
}
.tree-row.selected .row-name { font-weight: 500; }
.row-name-input {
    flex: 1;
    min-width: 0;
    height: 20dp;
    margin: 0 2dp 0 0;
    padding: 0 4dp;
    border-width: 1dp;
    border-radius: 2dp;

    font-size: 11dp;
}
.row-indicators {
    display: flex;
    flex: 0 0 auto;
    flex-direction: row;
    align-items: center;
}
.row-override-indicator,
.row-shared-type {
    display: inline-block;
    width: 14dp;
    text-align: center;

    font-size: 11dp;
}
.row-shared-type {
    font-family: tabler-icons;
}
.row-menu {
    flex: 0 0 auto;
    width: 16dp;
    margin-left: 2dp;
}/* Instance row inside a layer group: indented under its header so the
   layer -> entities containment reads as a tree,
not a flat list. */
.tree-row.in-layer { padding-left: 24dp; }

/* -- Hierarchy layer group headers (reuses the Inspector's eye/lock) -------- */
.layer-group-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 26dp;
    padding: 0 10dp 0 4dp;
    margin-top: 2dp;

    border-left: 2dp transparent;

    font-size: 11dp;
    font-weight: 600;
    transition: background-color 0.1s, color 0.1s;
}
.layer-group-header.active {

    border-left-width: 2dp;
}
.layer-chevron {
    flex: 0 0 auto;
    width: 16dp;
    text-align: center;
}
.layer-group-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    padding: 0 4dp;
}
.layer-count {
    flex: 0 0 auto;
    margin-left: 4dp;

    font-size: 10dp;
    font-weight: 500;
}
.tree-empty {
    display: block;
    padding: 10dp;
}

.hierarchy-empty-state {
    display: block;
    padding: 24dp 16dp 16dp 16dp;
    text-align: center;
}
.hierarchy-empty-icon {
    display: block;
    margin-bottom: 10dp;

    font-family: tabler-icons;
    font-size: 28dp;
}
.hierarchy-empty-title {
    display: block;
    margin-bottom: 4dp;

    font-size: 13dp;
    font-weight: 600;
}
.hierarchy-empty-copy {
    display: block;
    margin-bottom: 12dp;

    font-size: 11dp;
}
.hierarchy-empty-action { margin: 0; }

/* -- Text inputs — flat, accent border on focus (no glow) ------------------ */
.prop-input {
    flex: 1;
    height: 26dp;
    line-height: 26dp;
    padding: 0 8dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 12dp;
    transition: border-color 0.1s;
}
/* Frozen while Play runs: the field is non-editable, so it reads as inert. */

/* Scene context + Appearance (ADR-0020). */
.inspector-scene-context {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    height: 28dp;
    margin: 0 0 4dp 0;
    padding: 0 0 8dp 0;
    border-bottom-width: 1px;

    font-size: 12dp;
}
.inspector-scene-context .context-kind {

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}
.inspector-scene-context .context-name {
    font-weight: 600;
    font-size: 13dp;
}

.prop-subheading {
    margin: 8dp 0 2dp 0;
    padding-left: 0;

    font-size: 10dp;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}
.prop-row.prop-meta { height: 22dp; margin-bottom: 2dp; }
.prop-meta-value {
    flex: 1;
    min-width: 0;

    font-size: 11dp;
    font-family: "JetBrains Mono";
}
.prop-copy {
    width: 22dp;
    height: 22dp;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border: 1px transparent;
    border-radius: 2dp;

    cursor: pointer;
}
.prop-start-badge {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    height: 26dp;
    padding: 0 8dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 12dp;
}

.prop-color-block {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 6dp;
}
.prop-color-block > .prop-label { width: 78dp; }
.color-field {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    min-width: 0;
    height: 26dp;

    border-width: 1px;
    border-radius: 2dp;
    overflow: hidden;
}
.color-swatch {
    width: 24dp;
    height: 24dp;
    margin: 2dp;
    border-width: 0;
    border-radius: 2dp;
    flex-shrink: 0;
    cursor: pointer;
    overflow: hidden;
}
.color-swatch.disabled { cursor: default; }
.color-swatch-checker {
    width: 100%;
    height: 100%;
    border-radius: 2dp;
    /* RmlUi GL3 backend only loads uncompressed 24/32-bit TGA (not PNG). */
    decorator: image(checker-8.tga);
}
.prop-input.color-hex {
    flex: 1;
    min-width: 72dp;
    height: 26dp;
    line-height: 26dp;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}
.prop-input.color-hex:focus {
    border-width: 0;
    background-color: transparent;
}
/* Block + line-height (not flex): RmlUi does not centre icon glyphs in flex
   buttons; also kill the global .icon margin-right: 6dp that shifted the X. */
.color-reset {
    display: block;
    width: 26dp;
    height: 26dp;
    line-height: 26dp;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-left-width: 1px;
    border-radius: 0;

    text-align: center;
    cursor: pointer;
    flex-shrink: 0;
}
.color-reset .icon {
    margin: 0;
    font-size: 15dp;
    line-height: 26dp;
    vertical-align: top;
}
.color-reset.disabled,
.color-reset:disabled {

    cursor: default;
}

.prop-row.opacity-row { height: 28dp; margin-bottom: 6dp; }
.inspector-opacity-slider {
    flex: 1;
    min-width: 72dp;
    height: 22dp;
    margin-right: 8dp;
    border: 1px transparent;
    box-sizing: border-box;
}
.inspector-opacity-slider slidertrack {
    height: 4dp;
    /* ds-exception(spacing): centres 4dp track inside fixed 22dp input; ref=scene */
    margin-top: 9dp;

    border-radius: 2dp;
}
.inspector-opacity-slider sliderbar {
    width: 14dp;
    height: 14dp;
    margin-top: 4dp;

    /* ds-exception(radius): radius derives from fixed 14dp thumb geometry; ref=scene */
    border-radius: 7dp;
    border: 2dp transparent;
    box-sizing: border-box;
}
.inspector-opacity-slider sliderprogress {
    height: 4dp;
    margin-top: 0;

    border-radius: 2dp;
}
.inspector-opacity-slider sliderarrowdec,
.inspector-opacity-slider sliderarrowinc { display: none; }
.prop-input.opacity-value {
    flex: 0 0 44dp;
    width: 44dp;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}
