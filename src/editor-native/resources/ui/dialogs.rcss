/* Help dialogs — Keyboard Shortcuts + About (presentation-only). */

.help-dialog {
    width: 720dp;
    max-width: 92%;
    max-height: 86%;

    border-width: 1px;
    border-radius: 4dp;
    display: flex;
    flex-direction: column;
}

.keyboard-shortcuts-dialog {
    height: 560dp;
}

.about-dialog {
    width: 440dp;
    height: auto;
}

.help-dialog-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 12dp 12dp;
    border-bottom-width: 1px;
}

.help-dialog-title {
    flex: 1;
    font-size: 15dp;
    font-weight: 600;

}

.help-dialog-close {
    width: 28dp;
    height: 28dp;
    line-height: 26dp;
    text-align: center;
    background-color: transparent;
    border: 1px transparent;
    border-radius: 2dp;

    font-size: 18dp;
}


.shortcuts-toolbar {
    display: flex;
    padding: 12dp;
    border-bottom-width: 1px;
}

.shortcuts-search {
    flex: 1;
    height: 30dp;
    padding: 0 10dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 12dp;
}

.shortcuts-tabs {
    display: flex;
    flex-direction: row;
    padding: 8dp 12dp;
    border-bottom-width: 1px;
}

.shortcuts-tab {
    height: 26dp;
    line-height: 24dp;
    margin-right: 6dp;
    padding: 0 10dp;
    background-color: transparent;
    border: 1px transparent;
    border-radius: 2dp;

    font-size: 12dp;
}



.shortcuts-list {
    flex: 1;
    overflow-y: auto;
    padding: 4dp 0 8dp 0;
}

.shortcut-section {
    padding: 10dp 12dp 4dp 12dp;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1dp;
}

.shortcut-row {
    display: flex;
    flex-direction: row;
    height: 34dp;
    padding: 0 12dp;
    border-bottom-width: 1px;
}


.shortcut-row-unavailable {
    opacity: 0.45;
}

.shortcut-label {
    flex: 1;
    line-height: 34dp;

    font-size: 12dp;
}

.shortcut-gesture {
    width: 220dp;
    line-height: 34dp;
    text-align: right;

    font-family: "JetBrains Mono";
    font-size: 11dp;
}

.shortcuts-empty {
    padding: 24dp 12dp;

    font-size: 12dp;
    text-align: center;
}

.help-dialog-footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    padding: 10dp 12dp;
    border-top-width: 1px;
}

.about-body {
    padding: 24dp 24dp 8dp 24dp;
    text-align: center;
}

.about-brand {
    font-size: 12dp;
    font-weight: 700;
    letter-spacing: 2dp;

    margin-bottom: 8dp;
}

.about-product {
    font-size: 18dp;
    font-weight: 600;

    margin-bottom: 4dp;
}

.about-version {
    font-size: 12dp;

    margin-bottom: 12dp;
}

.about-tagline {
    font-size: 12dp;

    margin-bottom: 16dp;
}

.about-meta {
    text-align: left;
    margin: 0 auto;
    max-width: 320dp;
}

.about-meta-row {
    display: flex;
    flex-direction: row;
    padding: 4dp 0;
}

.about-meta-key {
    width: 140dp;

    font-size: 12dp;
}

.about-meta-value {
    flex: 1;

    font-size: 12dp;
}

.about-copyright {
    margin-top: 12dp;
    justify-content: center;
}

.about-copyright .about-meta-value {
    text-align: center;

    font-size: 11dp;
}

/* Reuse confirm backdrop positioning for the Help host. */
#editor-help-modal {
    z-index: 320;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

#editor-help-modal.hidden {
    display: none;
}
