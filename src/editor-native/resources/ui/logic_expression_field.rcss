/* ADR-0028 — Number Expression Editor structure only (colours in theme.rcss). */

/* Label above, fields below. `.logic-inline` centres its children on one row,
   which reads fine for a single control but leaves a Vec2's label hanging
   beside a two-row block. */
.logic-property.stacked {
    flex-direction: column;
    align-items: stretch;
}
.logic-property.stacked .logic-block-label {
    margin-right: 0;
    margin-bottom: 4dp;
}
/* `.logic-vec2-group` carries `flex: 1` to fill the width when it sits beside
   its label. Once stacked, the parent is a column, so the same declaration
   asks it to grow in *height* — with no definite height to grow into it
   collapses and the two axis rows draw on top of the next control. */
.logic-property.stacked .logic-vec2-group {
    flex: 0 0 auto;
}

.logic-vec2-group {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.logic-parameter-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 4dp;
}

.logic-parameter-label {
    width: 18dp;
    margin-right: 6dp;
    font-size: 12dp;
}

/* ADR-0029 — one control per axis. The `fx` badge, the summary button and the
   duplicate Edit button are gone: a literal and an expression are now the same
   field, so reverting costs a keystroke instead of a modal round-trip. The
   26dp height is .prop-input's, which is what the two old controls disagreed
   about (28dp vs 26dp) and why the X and Y rows did not line up. */
.logic-expression-input {
    flex: 1;
    min-width: 0;
}

/* The parse error sits under the field it belongs to, in flow, so the row
   below is pushed rather than covered. */
.logic-expression-error {
    display: block;
    margin: 0 0 4dp 24dp;
    padding: 4dp 6dp;
    border-width: 1px;
    border-radius: 2dp;
    font-size: 11dp;
}

/* In flow, not a popup: the Logic Board scrolls and clips absolutely
   positioned children — the same reason the property dropdowns live in flow. */
.logic-expression-completions {
    display: block;
    margin: 0 0 6dp 24dp;
    padding: 4dp;
    max-height: 150dp;
    overflow-y: auto;
    border-width: 1px;
    border-radius: 2dp;
}

.logic-expression-completion {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 4dp 8dp;
    background-color: transparent;
    border-width: 0;
    border-radius: 2dp;
    text-align: left;
}

.logic-expression-completion-label {
    display: inline-block;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}

.logic-expression-completion-summary {
    display: inline-block;
    margin-left: 8dp;
    font-size: 10dp;
}

.logic-expression-completion-empty {
    display: block;
    padding: 4dp 8dp;
    font-size: 11dp;
}
