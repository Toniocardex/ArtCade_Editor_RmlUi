/* panels.rcss — panel surfaces, headers, console rows, inspector sections.
   Lengths in `dp` (DPI-scaled); 1px borders stay physical hairlines. */

#left-col  { border-right-width: 1px; }
#right-col { border-left-width: 1px; }

.panel-header {
    display: block;
    position: relative;
    height: 32dp;
    line-height: 32dp;
    padding: 0 12dp;

    border-bottom-width: 1px;
}

/* Right-aligned action in a panel header (Console Copy). */
.header-btn {
    position: absolute;
    top: 5dp;
    right: 8dp;
    display: inline-block;
    height: 22dp;
    line-height: 22dp;
    padding: 0 10dp;
    background-color: transparent;
    border-width: 1px;
    border-radius: 2dp;

    font-size: 11dp;
    font-weight: 500;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}
/* Console header: Copy plus a compact chevron that toggles the dock. */
#btn-console-copy { right: 38dp; }
.console-collapse-btn {
    position: absolute;
    top: 5dp;
    right: 8dp;
    width: 24dp;
    height: 22dp;
    line-height: 20dp;
    margin: 0;
    padding: 0;
    text-align: center;
    background-color: transparent;
    border: 1px transparent;
    border-radius: 2dp;

    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}
.console-collapse-btn .icon {
    margin: 0;

}

.assets {
    display: block;
    flex: 1;
    padding: 6dp 8dp;
    overflow-y: auto;
}
.assets-empty {
    display: block;
    padding: 6dp 4dp;

    font-size: 11dp;
}
.asset-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 24dp;
    margin: 2dp 0;
    padding: 0 4dp;
    border-radius: 2dp;
    transition: background-color 0.1s;
}
/* Kind glyph column: fixed width keeps names aligned when a row has no icon. */
.asset-ico {
    display: inline-block;
    width: 16dp;
    margin-right: 4dp;
    text-align: center;

    font-size: 12dp;
}
.asset-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    margin-right: 6dp;

    font-size: 12dp;
}
.asset-meta {

    font-size: 11dp;
    margin-right: 6dp;
}
/* Provenance line under a derived asset ("from <source image>"). Indent lines
   up with the name column: 4dp row padding + 16dp icon + 4dp gap. */
.asset-sub {
    display: block;
    margin: 0 0 4dp 24dp;

    font-size: 10dp;
    white-space: nowrap;
    overflow: hidden;
}
.asset-group-title {
    display: block;
    margin: 8dp 0 4dp 0;

    font-size: 10dp;
    font-weight: 600;
    letter-spacing: 0.5dp;
}
/* Assets accordion: keep display:block (shared with Inspector drop-lists).
   Never use flex here — RmlUi turns bare text glyphs into flex items. */
.assets .asset-group-title {
    padding: 2dp 2dp;
    border-radius: 2dp;
}
.asset-group-caret {
    display: inline-block;
    width: 14dp;
    margin-right: 2dp;
    text-align: center;
    font-family: tabler-icons;
    font-size: 11dp;
    font-weight: 400;

}
.asset-group-label {
    display: inline;
}
/* Item count beside a category title. */
.asset-count {
    margin-left: 6dp;
    padding: 0 4dp;
    border-radius: 8dp;

    font-size: 10dp;
    font-weight: 600;
}
/* The unified Import dropdown sits above the categories. */
.assets .asset-import { display: block; margin: 2dp 0 8dp 0; }
.assets .asset-import-trigger {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 46dp;
    line-height: 18dp;
    padding: 4dp 10dp;
    margin: 0;
    text-align: left;

}
.asset-import .create-dropdown { top: 45dp; }
.asset-import-title { display: block;  font-size: 12dp; font-weight: 600; }
.asset-import-subtitle { display: block;  font-size: 10dp; font-weight: 400; }
.assets-search-slot {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 30dp;
    padding: 6dp 8dp 0 8dp;
}
.assets-search-icon {
    display: inline-block;
    width: 20dp;
    line-height: 24dp;

    font-family: tabler-icons;
    font-size: 11dp;
}
.assets-search-field {
    display: block;
    flex: 1;
    box-sizing: border-box;
    width: auto;
    height: 24dp;
    line-height: 24dp;
    padding: 0 8dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 11dp;
}
.hierarchy-search-slot {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 30dp;
    padding: 6dp 8dp 0 8dp;
}
.hierarchy-search-icon {
    display: inline-block;
    width: 20dp;
    line-height: 24dp;

    font-family: tabler-icons;
    font-size: 11dp;
}
.hierarchy-search-field {
    display: block;
    flex: 1;
    box-sizing: border-box;
    width: auto;
    height: 24dp;
    line-height: 24dp;
    padding: 0 8dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 11dp;
}
.assets-filter-empty {
    display: block;
    padding: 8dp 4dp 2dp 4dp;

    font-size: 11dp;
}

/* Scene View empty state — centred guidance instead of a bare corner note.
   Sits over the transparent viewport (raylib backdrop behind). ADR-0030 hub. */
.viewport-empty {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
}
.viewport-empty-box {
    display: block;
    text-align: center;
    max-width: 480dp;
    width: 90%;
}
.viewport-empty-title {
    display: block;
    font-size: 18dp;
    font-weight: 600;
    margin-bottom: 8dp;
}
.viewport-empty-sub {
    display: block;
    font-size: 12dp;
    margin-bottom: 16dp;
}
.viewport-empty-actions {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 10dp;
    margin-bottom: 24dp;
}
.viewport-empty-btn,
.viewport-empty-btn-secondary {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6dp;
    box-sizing: border-box;
    height: 32dp;
    min-width: 156dp;
    line-height: 32dp;
    padding: 0 16dp;
    border-width: 1px;
    border-radius: 2dp;
    font-size: 13dp;
    font-weight: 600;
    white-space: nowrap;
    transition: background-color 0.1s, border-color 0.1s;
}
.viewport-empty-btn-secondary {
    background-color: transparent;
}
.viewport-recent {
    display: block;
    text-align: left;
    width: 100%;
}
.viewport-recent-header {
    display: block;
    font-size: 10dp;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-bottom: 6dp;
    margin-bottom: 6dp;
    border-bottom-width: 1px;
}
.viewport-recent-list {
    display: block;
    max-height: 220dp;
    overflow-y: auto;
}
.viewport-recent-empty {
    display: block;
    font-size: 11dp;
    padding: 8dp 2dp;
}
.viewport-recent-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8dp;
    padding: 4dp 4dp;
    margin-bottom: 2dp;
    border-width: 1px;
    border-radius: 2dp;
}
.viewport-recent-main {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    text-align: left;
    padding: 4dp 6dp;
    border-width: 0;
    border-radius: 2dp;
}
.viewport-recent-name {
    display: block;
    font-size: 13dp;
    font-weight: 600;
    white-space: nowrap;
    overflow-x: hidden;
}
.viewport-recent-path {
    display: block;
    font-size: 11dp;
    margin-top: 2dp;
    white-space: nowrap;
    overflow-x: hidden;
}
.viewport-recent-missing {
    display: inline-block;
    font-size: 10dp;
    font-weight: 600;
    margin-left: 6dp;
}
.viewport-recent-remove {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 24dp;
    height: 24dp;
    flex-shrink: 0;
    border-width: 0;
    border-radius: 2dp;
    font-size: 15dp;
}

/* Console error/warning tally in the header: reads the log's health without
   opening it. Counts light up only when non-zero. */
.console-counts {
    margin-left: 12dp;
    font-size: 10dp;
    font-weight: 500;
    letter-spacing: 0.4dp;
    text-transform: none;

}
.console-counts .count-err  {  font-weight: 600; }
.console-counts .count-warn {  font-weight: 600; }

/* Console toolbar — level toggles, search, Clear. Local visual state only:
   nothing here is authoring, so a click is a plain Intent, not a Command. */
.console-toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 30dp;
    padding: 0 10dp;

    border-bottom-width: 1px;
}
.console-toggle {
    display: inline-block;
    height: 22dp;
    line-height: 22dp;
    margin-right: 4dp;
    padding: 0 10dp;
    background-color: transparent;
    border-width: 1px;
    border-radius: 2dp;

    font-size: 10dp;
    font-weight: 600;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}
/* Same blue-accent active convention as the toolbar's Grid/Snap toggles;
   Warn/Error override with their own log-level colour. */
/* Flex-sizing shell for the search field. Elements parsed statically from RML
   at document load do not render as text inputs in this RmlUi build — every
   working text field in this app (Name, Width, Height, ...) is injected via
   SetInnerRML at runtime instead, so the slot holds a place in the flex row
   and ConsolePanel injects the real <input> into it once. */
.console-search-slot {
    display: block;
    flex: 1;
    height: 22dp;
    margin-right: 8dp;
}
.console-search-field {
    display: block;
    box-sizing: border-box;   /* width:100% must include padding/border, or it
                                 overflows the slot and overlaps Clear next to it */
    width: 100%;
    height: 22dp;
    line-height: 22dp;
    padding: 0 8dp;

    border-width: 1px;
    border-radius: 2dp;

    font-size: 11dp;
    transition: border-color 0.1s;
}
/* In-flow Clear button — unlike .header-btn (absolute, for the panel-header
   row), this one lives in the normal toolbar flex flow. */
.console-clear-btn {
    display: inline-block;
    height: 22dp;
    line-height: 22dp;
    padding: 0 10dp;
    background-color: transparent;
    border-width: 1px;
    border-radius: 2dp;

    font-size: 11dp;
    font-weight: 500;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}

/* Console — monospace: log lines are technical output, fixed-width helps
   scanning stack-like or tabular messages. */
.console {
    display: block;
    flex: 1;
    padding: 8dp 12dp;
    font-family: JetBrains Mono;
    font-size: 11dp;
}
.log {
    display: block;
    padding: 2dp 6dp;
    border-radius: 2dp;

    transition: background-color 0.1s;
}

/* Inspector */
.inspector {
    display: block;
    flex: 1;
    padding: 8dp 12dp 16dp 12dp;
}
.inspector-empty {

    padding: 12dp 0;
}

/* Section eyebrow + bottom hairline (flat, no accent outline). */
.prop-group-title {
    display: block;
    height: 28dp;
    line-height: 28dp;
    margin-top: 12dp;
    margin-bottom: 8dp;
    border-bottom-width: 1px;
    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1.1dp;
    text-transform: uppercase;

}

/* Component section header: eyebrow title + ownership badge + remove (x). */
.comp-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 28dp;
    margin-top: 12dp;
    margin-bottom: 8dp;
    border-bottom-width: 1px;
}
.comp-title {
    flex: 1;
    line-height: 28dp;
    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1.1dp;
    text-transform: uppercase;

}
.comp-toggle { cursor: pointer; }
.comp-caret {
    display: inline-block;
    width: 15dp;

    font-family: tabler-icons;
    font-weight: 400;
}
.comp-badge {
    display: inline-block;
    height: 16dp;
    line-height: 16dp;
    padding: 0 6dp;
    margin-right: 4dp;
    border-radius: 8dp;

    border-width: 1px;

    font-size: 10dp;
    font-weight: 600;
    letter-spacing: 0.6dp;
}
.comp-help {
    display: inline-block;
    width: 16dp;
    height: 16dp;
    line-height: 14dp;
    margin: 0 0 0 6dp;
    padding: 0;
    background-color: transparent;
    border-width: 1px;
    border-radius: 8dp;

    font-size: 10dp;
    font-weight: 700;
    text-align: center;
    vertical-align: middle;
    transition: background-color 0.1s, border-color 0.1s, color 0.1s;
}
.comp-remove {
    display: inline-block;
    width: 22dp;
    height: 22dp;
    line-height: 22dp;
    text-align: center;
    border-radius: 2dp;

    transition: background-color 0.1s, color 0.1s;
}

.prop-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 28dp;
    margin-bottom: 6dp;
}
.prop-label {
    width: 78dp;

    font-size: 11dp;
    flex-shrink: 0;
}
.prop-readonly {
    flex: 1;

    font-size: 12dp;
}
/* Buttons inside a prop-row ("Set as Start", On/Off toggles): panel-btn's
   default 5dp bottom margin would push them ~2dp above the row's centre. */
.prop-row .panel-btn { margin: 0; }

.script-attachment-row {
    display: flex;
    align-items: center;
    gap: 4dp;
    margin: 4dp 0;
}

.script-attachment-row .panel-btn { margin: 0; min-width: 32dp; }

.script-attachment-name {
    flex: 1;
    min-width: 0;
    padding: 4dp 6dp;

    background-color: transparent;
    border-width: 0;
    text-align: left;
}

.script-attachment-action {
    width: 24dp;
    height: 24dp;
    padding: 0;

    background-color: transparent;
    border-width: 0;
    text-align: center;
}

.mode-block {
    display: block;
    margin: 2dp 0 8dp 0;
}
.mode-label {
    display: block;
    margin-bottom: 4dp;

    font-size: 11dp;
}
.mode-options {
    display: block;
}
.mode-option {
    margin: 0 4dp 4dp 0;
}

/* A non-zero diagnostic count reads as a soft warning. */
.prop-readonly.warn {  font-weight: 600; }
/* Unit suffix after a numeric field (e.g. "wu"). */
.prop-unit {
    margin-left: 6dp;

    font-size: 11dp;
    flex-shrink: 0;
}
/* Inspector breadcrumb: the only deliberate way to deselect and return to
   the Scene Inspector (Escape never does - scene_view_interaction.cpp). Text
   only, no icon glyph - no verified Tabler codepoint for a back/chevron
   shape in this build, and raw Unicode arrows have no glyph in Inter. */
.inspector-breadcrumb {
    display: block;
    margin: 2dp 0 8dp 0;

    font-size: 11dp;
    cursor: pointer;
}

.outside-warning {
    display: block;
    margin: 2dp 0 8dp 0;
    padding: 6dp 8dp;
    border-left-width: 2dp;

    font-size: 11dp;
}
/* Variant for a warning that opens the panel (locked-layer note): match the
   14dp breathing room a comp-header would give as the first element. */
.outside-warning.panel-top { margin-top: 12dp; }
/* -- Object Variables (ADR-0031) -------------------------------------------
   One block per variable so a list of them reads as several things rather than
   one long ladder of rows. Name and type share the first line, and Reset sits
   on the override's own row: both pairs are one decision, and splitting them
   cost a row each. Colours come from theme.rcss — the separator reuses the
   Inspector's own border token. */
.object-variable {
    display: block;
    margin: 0 0 4dp 0;
    padding: 6dp 0 2dp 0;
}
.object-variable + .object-variable {
    border-top-width: 1px;
}
.object-variable-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 4dp;
}
.object-variable-name {
    flex: 1 1 0;
    min-width: 0;
    margin-right: 4dp;
}
.object-variable-type {
    flex: 0 0 88dp;
    margin-right: 2dp;
}
/* The reset sits beside the value it undoes, not under it. */
.object-variable-reset {
    flex: 0 0 auto;
    margin-left: 4dp;
}
.object-variable-draft-error {
    display: block;
    /* ds-exception(spacing): aligns validation with the variable-value column; ref=scene */
    margin: 0 0 4dp 72dp;
    font-size: 10dp;
}

.type-owned-note {
    display: block;
    margin: 0 0 6dp 0;
    padding: 4dp 8dp;

    font-size: 10dp;
}

/* -- Tile Palette sheet (workspace dock under Scene View) ------------------
   One transparent hole: raylib paints the whole tileset sheet into it after
   RmlUi renders (same pattern as the Scene View viewport and the Tileset
   Editor canvas), preserving the sheet's spatial layout. No data-action here
   — every click/drag/wheel is routed app-side (tile_palette_input.cpp), so
   RmlUi never double-fires on the same gesture. Fills the dock body under
   the chrome; sheets larger than the hole use Ctrl+Wheel zoom and
   middle/Space pan (Slice 1 — professional zoom/scrollbars land in Slice 3). */
.tile-palette-sheet {
    display: block;
    flex: 1;
    min-height: 80dp;
    margin: 4dp 0 0 0;

    border-width: 1px;
    border-radius: 2dp;
    /* Raylib owns clicks inside the hole. */
    pointer-events: none;
}
/* Palette header row (tile count). */
.tile-palette-head {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
.tile-palette-empty {
    display: block;
    padding: 8dp;
    margin: 4dp 0 6dp 0;

    font-size: 11dp;

    border-width: 1px;
    border-radius: 4dp;
}
/* The "Open Tileset Editor" call-to-action follows the message on its own
   line — give it air above and drop the stray default bottom margin. */
.tile-palette-empty .panel-btn { margin: 8dp 0 0 0; }
/* Dock-wide empty state (no tilemap selected): fills the flex-row body and
   recentres the hierarchy-empty-state block it reuses. */
.tile-palette-empty-state {
    flex: 1;
    padding: 12dp 16dp;
}
.tile-palette-selected {
    display: block;
    margin: 0 0 10dp 0;

    font-size: 11dp;
}
.tile-palette-selected .value {  font-weight: 600; }

/* Shared in-editor modal (ADR-0013 component-remove confirm, etc.). */
.editor-modal-backdrop {
    position: absolute;
    left: 0px;
    right: 0px;
    top: 0px;
    bottom: 0px;
    z-index: 80;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
.editor-modal-backdrop.hidden { display: none; }
.editor-modal {
    width: 420px;
    max-width: 90%;
    padding: 16dp 24dp;

    border-width: 1px;

}
.editor-modal-title {
    display: block;
    font-size: 15dp;
    font-weight: 600;
    margin-bottom: 8dp;
}
.editor-modal-copy {
    display: block;
    font-size: 12dp;

    margin-bottom: 10dp;
    line-height: 1.45;
    white-space: pre-wrap;
}
.editor-modal-hint {
    display: block;
    font-size: 11dp;

    margin-bottom: 16dp;
    line-height: 1.4;
    white-space: pre-wrap;
}
.editor-modal-actions {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8dp;
}

