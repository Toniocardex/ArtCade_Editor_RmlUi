/* tileset_editor.rcss — Tileset Editor overlay. Same design language as the
   Sprite Animation Editor (zinc surfaces, blue accent, flat fills, low
   radius) — see sprite-animation/sprite_animation_editor.rcss for the shared
   conventions this mirrors. RmlUi has no browser default stylesheet — every
   element is display:inline unless declared otherwise, so each container
   here sets its display explicitly. Raw text must not sit directly inside a
   display:flex element (it won't render); text always lives in a span/div. */

.tileset-editor-body {
    width: 100%;
    height: 100%;
    display: block;

}

.tileset-editor {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;

}

.tileset-editor-shell {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: 12dp;

}

/* -- Header bar -------------------------------------------------------------- */
.tileset-editor-title {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 36dp;
    margin-bottom: 10dp;

}
.tileset-editor-eyebrow {
    display: inline-block;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1.1dp;
    text-transform: uppercase;
}
.tileset-editor-name {
    flex: 0 0 auto;
    width: 160dp;
    height: 24dp;
    margin-left: 10dp;

    font-size: 13dp;
    font-weight: 600;
}
.tileset-editor-title .panel-btn { margin: 0 0 6dp 10dp; }
.tileset-editor-source {
    display: inline-block;
    margin-left: 10dp;

    font-size: 11dp;
}
/* Dirty cue: neutral chip shows the committed tile count; the amber variant
   flags a pending slicing not yet applied (same fact the close guard acts on). */
.tileset-status-chip {
    display: inline-block;
    margin: 0 0 6dp auto;
    height: 18dp;
    line-height: 18dp;
    padding: 0 10dp;

    font-size: 10dp;


    /* ds-exception(radius): radius derives from fixed 18dp status-chip height; ref=tileset */
    border-radius: 9dp;
}


/* -- Main row: canvas | settings ---------------------------------------------- */
.tileset-editor-main {
    display: flex;
    flex-direction: row;
    flex: 1;
}

.tileset-canvas-col,
.tileset-settings {


    border-radius: 4dp;
}
.tileset-panel-title {
    display: block;
    height: 18dp;
    line-height: 18dp;
    margin-bottom: 8dp;

    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1.1dp;
    text-transform: uppercase;
}

.tileset-canvas-col {
    display: flex;
    flex-direction: column;
    flex: 1;
    margin-right: 10dp;
    padding: 10dp;
}
/* -- Zoom toolbar above the canvas (buttons drive the same zoom/pan intents
      as the wheel; the readout element is filled by id, outside the markup
      rebuild, so wheel ticks never steal input focus) ---------------------- */
.tileset-canvas-toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8dp;
}
.tileset-canvas-toolbar .tileset-panel-title {
    flex: 1;
    margin-bottom: 0;
}
.tileset-zoom-btn {
    width: 24dp;
    height: 22dp;
    line-height: 20dp;
    padding: 0;
    text-align: center;
}
.tileset-zoom-readout {
    display: inline-block;
    width: 44dp;

    font-size: 11dp;
    text-align: center;
}
.tileset-zoom-fit {
    height: 22dp;
    line-height: 20dp;
    padding: 0 8dp;
    margin-left: 6dp;
}
#tileset-canvas {
    display: block;
    flex: 1;
    min-height: 120dp;


    border-radius: 4dp;
}
.tileset-canvas-status {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 8dp;

    font-size: 11dp;
}
.tileset-canvas-status span { display: inline-block; margin-right: 12dp; }

.tileset-status-hint { margin-left: auto; margin-right: 0; }

/* -- Settings column: slicing form + Apply/Cancel ----------------------------- */
.tileset-settings {
    display: flex;
    flex-direction: column;
    width: 260dp;
    padding: 10dp 12dp;
}
.tileset-settings .prop-label { width: 64dp; }
.tileset-slice-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 26dp;
    margin-bottom: 6dp;
}
.tileset-slice-row .prop-input {
    flex: 1;
    height: 24dp;
    line-height: 24dp;
    margin-left: 4dp;
}
/* Live coverage line under the form: the same computeTilesetSlicing math the
   renderer draws, answered next to the fields that caused it. */
.tileset-slice-feedback {
    display: block;
    margin-top: 4dp;

    font-size: 11dp;
    line-height: 15dp;
}



.tileset-settings-actions {
    display: flex;
    flex-direction: row;
    margin-top: 10dp;
}
.tileset-settings-actions .panel-btn {
    flex: 1;
    text-align: center;
}
.tileset-settings-actions #tileset-apply-btn { margin-right: 6dp; }



/* -- Selected tile: thumbnail slot (raylib paints the tile's crop into it
      after host.render(), the timeline-thumbnail pattern) + id/rect readout - */
.tileset-selected-title { margin-top: 16dp; }
.tileset-selected-row {
    display: flex;
    flex-direction: row;
    align-items: center;
}
.tileset-selected-thumb {
    display: block;
    width: 48dp;
    height: 48dp;


    border-radius: 2dp;
}
.tileset-selected-info {
    display: inline-block;
    margin-left: 10dp;

    font-size: 11dp;
    line-height: 16dp;
}
.tileset-selected-empty {
    display: block;

    font-size: 11dp;
    line-height: 15dp;
}
/* -- Committed tiles grid: .tile-thumb slots (shared with the Inspector
      palette, panels.rcss) inside the panel's own scroll region; raylib
      paints the crops after host.render(), clipped to this box. */
.tileset-tiles-title { margin-top: 16dp; }
.tileset-tiles-grid {
    display: block;
    max-height: 220dp;
    overflow-y: auto;
    margin-bottom: 6dp;
}
.tileset-tiles-more {
    display: block;
    margin: 2dp 0 4dp 0;

    font-size: 11dp;
}
.tileset-settings-diagnostic {
    display: block;
    margin-top: auto;
    padding-top: 12dp;

    font-size: 11dp;
    line-height: 15dp;
}
