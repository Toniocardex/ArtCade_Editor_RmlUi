/* gallery.rcss — ADR-0027 phase 4 specimen sheet.
   Structure only: every colour here comes from theme.rcss, exactly like any
   other component sheet (the gallery is a consumer of the roles, not an
   exception to them). Loaded always but inert until --shot-gallery injects
   the markup. */

/* Two columns, because the sheet has to fit in one window. Stacked in a single
   column it grew past the viewport, and everything below the fold was silently
   dropped from the capture — the reference kept passing while the last
   sections were never compared at all. Anything that scrolls here is not
   covered, so keep new sections paying their way in height. */
.gallery {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding: 16dp;
    overflow-y: auto;
    /* Explicit width: as a block it inherited its parent's, but a flex
       container that is itself a flex item shrinks to its content instead. */
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}

/* flex-basis, not width: as a flex item a plain `width: 50%` still lets the
   default shrink squeeze the column down to its content, which crushed the
   fixed-width cells inside it. */
.gallery-section {
    display: block;
    flex: 0 0 50%;
    box-sizing: border-box;
    padding-right: 16dp;
}

.gallery-section-title {
    display: block;
    margin: 16dp 0 6dp 0;
    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 1.2dp;
    text-transform: uppercase;
}

.gallery-row {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

/* Fixed cell so a specimen that changes size shifts only itself, keeping the
   rest of the sheet aligned — a whole-page reflow would swamp the diff. */
.gallery-cell {
    display: block;
    flex: 0 0 auto;
    width: 168dp;
    margin: 0 8dp 12dp 0;
}

.gallery-caption {
    display: block;
    margin-top: 4dp;
    font-size: 10dp;
    font-weight: 400;
}

.gallery-swatch {
    display: block;
    height: 40dp;
    border-width: 1px;
    border-radius: 2dp;
}

.gallery-text {
    display: block;
    height: 24dp;
    line-height: 24dp;
    font-size: 15dp;
    font-weight: 600;
}

.gallery-type {
    display: block;
    height: 32dp;
    line-height: 32dp;
    white-space: nowrap;
}
.type-eyebrow { font-size: 10dp; font-weight: 700; text-transform: uppercase; }
.type-body { font-size: 11dp; font-weight: 400; }
.type-label { font-size: 12dp; font-weight: 400; }
.type-control-strong { font-size: 13dp; font-weight: 600; }
.type-heading-small { font-size: 15dp; font-weight: 600; }
.type-heading { font-size: 18dp; font-weight: 600; }
.type-display { font-size: 28dp; font-weight: 700; }

.gallery-icon-button {
    display: inline-block;
    width: 28dp;
    height: 28dp;
    line-height: 28dp;
    padding: 0;
    text-align: center;
}
.gallery-icon-button .icon { margin-right: 0; }

/* Menu-family specimens need their real container: .menu-entry and friends
   are styled for the inside of a dropdown, not for bare page background. */
.gallery-menu {
    display: block;
    padding: 4dp;
    border-width: 1px;
    border-radius: 4dp;
}

/* .drop-list carries a 78dp left margin because in the Inspector it sits under
   a label column; inside a specimen cell that would push it out of frame. */
.gallery-menu.drop-list { margin: 0; }
