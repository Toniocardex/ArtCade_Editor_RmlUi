.script-toolbar-field {
    height: 30dp;
    margin-left: 6dp;
    display: flex;
    flex-direction: row;
    align-items: center;

    font-size: 10dp;
}
.script-toolbar-field input {
    width: 160dp;
    height: 28dp;
    margin-left: 4dp;
    padding: 0 8dp;

    border-width: 1px;

}
.script-goto-field input { width: 48dp; }

.script-editor-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;

}
.script-editor-panel.hidden { display: none; }
.script-editor-tabs {
    min-height: 34dp;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    overflow-x: auto;

    border-bottom-width: 1px;
}
.script-restart-banner {
    min-height: 36dp;
    padding: 0 10dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    border-bottom-width: 1px;

    font-size: 11dp;
}
.script-restart-banner.hidden { display: none; }
.script-restart-button {
    height: 26dp;
    padding: 0 10dp;

    border-width: 1px;

    font-size: 10dp;
}
.script-tab {
    min-width: 120dp;
    max-width: 240dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 10dp;
    border-right-width: 1px;

}
.script-tab.active {   border-top-width: 2px; }
.script-tab-name { flex: 1; overflow: hidden; }
.script-tab-dirty { margin-left: 4dp;  }
.script-tab-close {
    width: 25dp;
    height: 25dp;
    margin: 2dp 4dp;
    padding: 0;
    background-color: transparent;
    border: 0px transparent;

}
.script-editor-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

}
.script-editor-empty.hidden { display: none; }
.script-editor-empty-title { margin-bottom: 8dp;  font-size: 15dp; }
.script-editor-empty .panel-btn { margin-top: 12dp; }
.script-editor-body {
    flex: 1;
    width: 100%;
    height: 1dp;
    min-height: 0;
    display: flex;
    flex-direction: row;
    overflow: hidden;
}
.script-editor-body.hidden { display: none; }
.script-line-numbers {
    width: 50dp;
    padding: 12dp 10dp 12dp 0;
    overflow: hidden;
    text-align: right;

    border-right-width: 1px;

    font-family: "JetBrains Mono";
    font-size: 12dp;
    line-height: 18dp;
}
.script-line-current {

    font-weight: 700;
}
.script-editor-code {
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: stretch;

    flex: 1;
    width: 1dp;
    height: 100%;

    min-width: 0;
    min-height: 0;

    overflow: hidden;

}
.script-editor-highlight {
    position: absolute;
    top: 0dp;
    left: 0dp;
    right: 0dp;
    bottom: 0dp;
    padding: 12dp;
    overflow: hidden;
    background-color: transparent;
    font-family: "JetBrains Mono";
    font-size: 12dp;
    line-height: 18dp;
    white-space: pre;
    word-break: normal;
    z-index: 1;
    pointer-events: none;
}
.script-editor-highlight .lua-line {
    display: inline;
}
.script-editor-current-line {
    position: absolute;
    left: 0dp;
    right: 0dp;
    height: 18dp;

    pointer-events: none;
    z-index: 0;
    display: none;
}
.script-editor-current-line.visible { display: block; }
.script-editor-caret {
    position: absolute;
    width: 2dp;
    height: 18dp;

    pointer-events: none;
    z-index: 2;
    display: none;
}
.script-editor-caret.visible { display: block; }
.script-editor-textarea,
textarea#script-editor-textarea.script-editor-textarea {
    /* Deve partecipare al flex layout.
       Non usare absolute + width/height percentuali. */
    position: relative;
    display: block;

    flex: 1;
    width: auto;
    height: auto;

    min-width: 0;
    min-height: 0;

    padding: 12dp;
    box-sizing: border-box;

    overflow: auto;

    background-color: transparent;
    border: 0px transparent;

    font-family: "JetBrains Mono";
    font-size: 12dp;
    line-height: 18dp;

    text-transform: none;
    white-space: pre;
    word-break: normal;

    z-index: 1;
}
.script-editor-textarea:focus,
textarea#script-editor-textarea.script-editor-textarea:focus {
    border: 0px transparent;
}

textarea#script-editor-textarea scrollbarvertical {
    width: 10dp;
}
textarea#script-editor-textarea scrollbarvertical sliderbar {

    border-radius: 2dp;
    margin-left: 2dp;
    margin-right: 2dp;
    min-height: 32dp;
}

.script-diagnostics {
    display: flex;
    flex-direction: column;
    max-height: 94dp;
    overflow-y: auto;

    border-top-width: 1px;
}
.script-diagnostics.hidden { display: none; }
.script-diagnostic {
    display: block;
    width: 100%;
    padding: 4dp 10dp;
    border: 0px transparent;
    background-color: transparent;

    text-align: left;
    font-family: Inter;
    font-size: 11dp;
}
.script-editor-status {
    height: 24dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 10dp;

    border-top-width: 1px;

    font-size: 10dp;
}
.script-api-hint {
    flex: 1;
    overflow: hidden;

    font-family: "JetBrains Mono";
    font-size: 10dp;
    padding-right: 12dp;
}
.script-api-panel {
    width: 220dp;
    min-width: 180dp;
    height: 100%;
    display: flex;
    flex-direction: column;

    border-left-width: 1px;
}
.script-api-panel-header {
    height: 28dp;
    padding: 0 10dp;
    display: flex;
    flex-direction: row;
    align-items: center;

    font-size: 10dp;
    border-bottom-width: 1px;
}
.script-api-list {
    flex: 1;
    overflow-y: auto;
    padding: 4dp 0;
    min-height: 0;
}
.script-api-item {
    display: block;
    width: 100%;
    padding: 4dp 10dp;
    border: 0px transparent;
    background-color: transparent;

    text-align: left;
    font-family: "JetBrains Mono";
    font-size: 10dp;
}
.script-api-detail {
    display: flex;
    flex-direction: column;
    gap: 6dp;
    padding: 10dp;
    border-top-width: 1px;
    max-height: 42%;
    overflow-y: auto;
    min-height: 120dp;
}
.script-api-detail-name {

    font-family: Inter;
    font-size: 11dp;
    font-weight: 700;
}
.script-api-detail-doc {

    font-family: Inter;
    font-size: 10dp;
    line-height: 14dp;
}
.script-api-detail-label {

    font-family: Inter;
    font-size: 10dp;
    text-transform: uppercase;
}
.script-api-detail-sig {

    font-family: "JetBrains Mono";
    font-size: 10dp;
    white-space: pre-wrap;
}
.script-api-insert-btn {
    display: block;
    width: 100%;
    padding: 6dp 8dp;
    border-width: 1px;

    text-align: center;
    font-family: Inter;
    font-size: 10dp;
}
.script-api-insert-btn.hidden { display: none; }
.script-api-detail-status {

    font-family: Inter;
    font-size: 10dp;
    min-height: 14dp;
}
.script-completion-popup {
    position: absolute;
    left: 12dp;
    top: 30dp;
    min-width: 220dp;
    max-width: 360dp;
    max-height: 180dp;
    overflow-y: auto;

    border-width: 1px;
    z-index: 5;
}
.script-completion-popup.hidden { display: none; }
.script-completion-item {
    display: block;
    width: 100%;
    padding: 4dp 8dp;
    border: 0px transparent;
    background-color: transparent;

    text-align: left;
    font-family: "JetBrains Mono";
    font-size: 11dp;
}
.script-completion-item:hover,
